# Copy to .env.production on the server. Never commit the filled-in file.

# Absolute origin, no trailing slash. Feeds canonical URLs, hreflang alternates,
# the sitemap and Open Graph tags — a wrong value here silently breaks SEO.
# Baked in at build time: changing it needs a rebuild, not just a restart.
NEXT_PUBLIC_SITE_URL=https://tlshost.vn

# Where the waitlist file is written. Keep it OUTSIDE the git checkout so a
# deploy never overwrites collected signups.
#   sudo mkdir -p /var/lib/tlshost && sudo chown $USER /var/lib/tlshost
WAITLIST_FILE=/var/lib/tlshost/waitlist.jsonl

# --- Once the product application exists -------------------------------------
# Until these are set, "Start free" points at the on-site waitlist and the
# "Log in" links are not rendered at all.
#
# NEXT_PUBLIC_SIGN_UP_URL=https://app.tlshost.vn/signup
# NEXT_PUBLIC_LOG_IN_URL=https://app.tlshost.vn/login
